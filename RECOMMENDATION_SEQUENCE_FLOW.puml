@startuml RecommendationAlgorithmSequence

!define PATIENT_COLOR #E3F2FD
!define DATABASE_COLOR #FFF3E0
!define SERVICE_COLOR #F3E5F5
!define ENGINE_COLOR #E8F5E9

title Recommendation Algorithm - Detailed Sequence Flow

actor Patient as patient

participant "AppointmentsPage\nComponent" as apptsPage #PATIENT_COLOR
participant "RecommendationService" as recService #SERVICE_COLOR
participant "PatientService" as patientSvc #SERVICE_COLOR
participant "RecommendationEngine" as recEngine #ENGINE_COLOR
participant "Supabase\nDatabase" as database #DATABASE_COLOR

== User Initiates Booking ==
patient -> apptsPage: Selects appointment type\n(e.g., "Skin consultation")
patient -> apptsPage: Selects date ("2026-04-20")
patient -> apptsPage: Selects time ("09:00")

apptsPage -> apptsPage: [Trigger] handleTimeSlotSelect()

== Fetch Patient Appointment History ==
apptsPage -> recService: getRecommendations(\npatientId, type, date, time)

recService -> patientSvc: fetchAppointmentHistory(patientId)
patientSvc -> database: Query appointments\n.eq("patientId", patientId)\n.eq("status", "Completed")

database --> patientSvc: Return array of\npast appointments
note right patientSvc
  [
    {doctorId: "doc1", rating: 5, date: "2025-12-20"},
    {doctorId: "doc1", rating: 5, date: "2025-10-10"},
    {doctorId: "doc2", rating: 4, date: "2025-11-15"}
  ]
end note

patientSvc --> recService: appointmentHistory

== Fetch Available Doctors for Specialty & Time ==
recService -> recService: Look up specialty for type\nAPPOINTMENT_TYPE_SPECIALTIES["Skin consultation"]\n→ ["Dermatologist", "Family Medicine"]

note over recService
  Specialty Mapping:
  "Skin consultation" → 
  primary: ["Dermatologist"]
  secondary: ["Family Medicine"]
end note

recService -> patientSvc: getAvailableDoctorsForSlot(\nspecialties, date, time)

patientSvc -> database: Query doctors matching specialty
database --> patientSvc: Return doctor list\n(before availability filter)

patientSvc -> database: For each doctor, check if\ntime slot is available:\n.eq("doctorId", docId)\n.eq("appointment_date", date)\n.eq("time_slot", time)\n.is("appointment_id", null)

database --> patientSvc: Available time slots\nper doctor

note right patientSvc
  Available Doctors:
  [
    {id: "doc1", name: "Dr. De Chavez",\n specialty: "Dermatologist"},
    {id: "doc3", name: "Dr. Jimenez",\n specialty: "Dermatologist"}
  ]
end note

patientSvc --> recService: availableDoctors

== Recommendation Engine: Calculate Scores ==
recService -> recEngine: getTopRecommendedDoctors(\nappointmentHistory,\navailableDoctors, limit=3)

recEngine -> recEngine: Determine if new patient\nisNewPatient = (appointmentHistory.length === 0)

note right recEngine
  Check: Do we have history?
  → YES: Use returning patient formula
  → NO: Use new patient formula
end note

recEngine -> recEngine: Build doctorVisits map\nLoop through history:\n\n{
  "doc1": {
    count: 2,
    avgRating: 5.0,
    lastVisit: Date(2025-12-20)
  },
  "doc2": {
    count: 1,
    avgRating: 4.0,
    lastVisit: Date(2025-11-15)
  }
}

note right recEngine
  Aggregation Logic:
  For each appointment:
    - Count visits per doctor
    - Average ratings
    - Track last visit date
end note

recEngine -> recEngine: Score each available doctor\nLoop through availableDoctors:

rect rgb(230, 230, 250)
  note right recEngine
    SCORING FOR RETURNING PATIENTS:
    
    Doc1 (De Chavez):
    - Visits: 2 → (2/5) × 25 = 10 pts
    - Rating: 5.0 → (5/5) × 15 = 15 pts
    - Specialty: 60 pts (pre-filtered)
    - TOTAL: 60 + 10 + 15 = 85 pts
  end note
end

rect rgb(240, 250, 240)
  note right recEngine
    SCORING FOR RETURNING PATIENTS:
    
    Doc3 (Jimenez):
    - Visits: 0 → (0/5) × 25 = 0 pts
    - Rating: 0 → (0/5) × 15 = 0 pts
    - Specialty: 60 pts (pre-filtered)
    - TOTAL: 60 + 0 + 0 = 60 pts
  end note
end

recEngine -> recEngine: Sort array by score DESC\n[85, 60] → Descending order\n\nDoctor list is now ranked:
note right recEngine
  Sorted Results:
  1. Dr. De Chavez - Score: 85
  2. Dr. Jimenez - Score: 60
end note

recEngine -> recEngine: Slice top N (limit=3)\nreturn topRecommendations.slice(0, 3)

note right recEngine
  Top 3 Results:
  [
    {
      id: "doc1",
      name: "Dr. De Chavez",
      specialty: "Dermatologist",
      score: 85,
      visits: 2,
      avgRating: 5.0
    },
    {
      id: "doc3",
      name: "Dr. Jimenez",
      specialty: "Dermatologist",
      score: 60,
      visits: 0,
      avgRating: 0
    }
  ]
end note

recEngine --> recService: topRecommendations

== Format and Display Recommendations ==
recService -> apptsPage: Pass top recommendations

apptsPage -> apptsPage: Render RecommendedDoctors\ncomponent with data

apptsPage -> apptsPage: For each doctor,\nformat for display:\n\nformatRecommendationInfo(doctor)

note right apptsPage
  Formatting Logic:
  
  Dr. De Chavez (2 visits):
  → "2 visits • 5.0"
  
  Dr. Jimenez (0 visits):
  → "New to you"
end note

apptsPage --> patient: Display top 3 doctors\nwith scores and info

rect rgb(200, 220, 255)
  note over patient
    ╔════════════════════════════════╗
    ║   RECOMMENDED DOCTORS          ║
    ║                                ║
    ║ 1️⃣  Dr. De Chavez             ║
    ║     Dermatologist              ║
    ║     2 visits • 5.0 ⭐           ║
    ║                                ║
    ║ 2️⃣  Dr. Jimenez               ║
    ║     Dermatologist              ║
    ║     New to you                 ║
    ╚════════════════════════════════╝
    
    [Select Doctor]
  end note
end

== Patient Selects Doctor ==
patient -> apptsPage: Clicks "Select Dr. De Chavez"

apptsPage -> patientSvc: Verify availability\n(final double-check)

patientSvc -> database: isDoctorTimeslotAvailable(\ndocId, date, time)

database --> patientSvc: ✅ Available

patientSvc --> apptsPage: Confirmed available

apptsPage -> database: Create appointment record\n{\n  patientId,\n  doctorId: "doc1",\n  appointment_date: "2026-04-20",\n  time_slot: "09:00",\n  appointment_type: "Skin consultation",\n  status: "Booked"\n}

database --> apptsPage: ✅ Appointment created

apptsPage --> patient: ✅ Booking confirmed!\nAppointment scheduled

@enduml
